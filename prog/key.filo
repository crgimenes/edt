; A key the field did not take. The chords are the same in both views; the
; rest edit text, or move and type over bytes.
(let ((rows (text-rows)))
  (cond
    ((= MODE "edit")
      (do
        (set MSG "")
        (cond
          ((= KEY 19) (save ""))
          ((= KEY 17) (quit))
          ((= KEY 6) (set MODE "find"))
          ((= KEY 7) (find-next))
          ((= KEY 15) (set MODE "goto"))
          ((= KEY 12) (set BARE (not BARE)))
          ((= KEY 16) (pager-buffer))
          ((= KEY KEY_ESC) (set MODE "menu"))
          ((= VIEW "hex") (hex-key rows))
          ((= KEY 24) (do (tb-cut) (clipboard (tb-clip))))
          ((or (= KEY (+ KEY_INS KEY_CTRL)) (= KEY (+ KEY_DEL KEY_SHIFT)))
            (do (tb-key KEY rows) (clipboard (tb-clip))))
          (else (tb-key KEY rows)))))
    ((= MODE "menu")
      (do
        (set MODE "edit")
        (cond
          ((is-key 115 83) (save ""))
          ((is-key 97 65) (set MODE "saveas"))
          ((is-key 113 81) (quit))
          ((and (= VIEW "text") (is-key 100 68)) (do (tb-cut) (clipboard (tb-clip))))
          ((is-key 99 67) (do (tb-copy) (clipboard (tb-clip))))
          ((and (= VIEW "text") (or (is-key 112 80) (is-key 118 86))) (tb-paste))
          ((and (= VIEW "text") (or (is-key 108 76) (is-key 121 89))) (tb-key 25 rows))
          ((is-key 102 70) (set MODE "find"))
          ((is-key 110 78) (find-next))
          ((is-key 103 71) (set MODE "goto"))
          ((is-key 117 85) (undo))
          ((is-key 120 88) (toggle-view))
          ((is-key 109 77) (pager-buffer))
          ((is-key 104 72) (manual))
          ((is-key 98 66) (set BARE (not BARE)))
          ((and (filo-text?) (is-key 114 82)) (reformat))
          ((= KEY 58) (set MODE "cmd"))
          ((= KEY 47) (set MODE "find"))
          (else #t))))
    ((= MODE "quit")
      (cond
        ((is-key 121 89) (save-and-quit))
        ((is-key 110 78) (done))
        ((= KEY KEY_ESC) (set MODE "edit"))
        (else #t)))
    ((= KEY KEY_ESC) (do (set MODE "edit") (set LEAVE #f)))
    (else #t)))
